# Environment example
# Copy this file to .env and fill local values. Do not commit real secrets.
# For Windows/dev use only a dedicated dev bot token.
# Never run dev and prod polling at the same time on one TELEGRAM_BOT_TOKEN.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg2://helpdesk:helpdesk@db:5432/helpdesk
APP_TIMEZONE=Europe/Moscow
TELEGRAM_BOT_TOKEN=
# Keep false in local dev unless you intentionally run the dev bot polling loop.
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_TIMEOUT=25
TELEGRAM_DEFAULT_AGENT_ID=00000000-0000-0000-0000-000000000001
INITIAL_SEED_ENABLED=true
ATTACHMENT_STORAGE_DIR=/app/storage/attachments
BITRIX_WEBHOOK_BASE=
SESSION_SECRET_KEY=change-this-session-secret
SESSION_COOKIE_NAME=esdesk_session
# Set true behind HTTPS / reverse proxy in production.
SESSION_COOKIE_SECURE=false
DISABLE_ADMIN_IDLE_TIMEOUT=false
USE_DB_BUTTONS=false
