# Copy to .env.web and set the server interface IP and exact browser origin.
# Safe local example; for LAN access replace both 127.0.0.1 values.
# Do not use wildcard addresses (0.0.0.0 or ::).
WEB_BIND_IP=127.0.0.1
WEB_CLIENT_ORIGIN=http://127.0.0.1:5173

# Existing Docker network of the main PROD API.
WEB_NETWORK_NAME=es-desk_default
