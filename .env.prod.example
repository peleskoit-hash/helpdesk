# Production environment example for Ubuntu Server
# Copy to .env.prod and fill real secrets. Do not commit .env.prod.
# For local validation of docker-compose.prod.yml you can run:
# ESDESK_ENV_FILE=.env.prod.example docker compose -f docker-compose.prod.yml --env-file .env.prod.example config
# Do not keep ESDESK_ENV_FILE inside the real .env.prod.

APP_ENV=prod
APP_PUBLIC_BASE_URL=https://helpdesk.example.com
APP_TIMEZONE=Europe/Moscow

# PostgreSQL
POSTGRES_DB=esdesk_prod
POSTGRES_USER=esdesk_prod
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg2://esdesk_prod:change-me-strong-password@db:5432/esdesk_prod

# Telegram
# Do not run dev and prod polling at the same time on one TELEGRAM_BOT_TOKEN.
# For dev use a separate bot token or keep TELEGRAM_POLLING_ENABLED=false.
TELEGRAM_BOT_TOKEN=replace-with-real-prod-bot-token
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_TIMEOUT=25
TELEGRAM_DEFAULT_AGENT_ID=00000000-0000-0000-0000-000000000001

# App runtime
ATTACHMENT_STORAGE_DIR=/app/storage
# BITRIX_WEBHOOK_BASE is used by the old Bitrix phone lookup automation.
BITRIX_WEBHOOK_BASE=
# BITRIX_KC_WEBHOOK_BASE is used only by the call-center employee resolver.
# These are independent webhooks; there is no automatic fallback between them.
BITRIX_KC_WEBHOOK_BASE=
# Permanent valid Fernet key for Bitrix password encryption.
# Do not change it after first use without a separate rotation/migration.
BITRIX_PASSWORD_ENCRYPTION_KEY=replace-with-permanent-fernet-key
BITRIX_KC_DEPARTMENT_IDS=60
BITRIX_KC_REFRESH_INTERVAL_SECONDS=3600
BITRIX_KC_MAX_STALE_SECONDS=28800
BITRIX_KC_FINAL_WAIT_SECONDS=5
BITRIX_KC_REQUEST_TIMEOUT_SECONDS=10
BITRIX_KC_RETRY_COUNT=1
INITIAL_SEED_ENABLED=false
INTEGRATION_API_KEY=replace-with-prod-integration-api-key

# Session / auth
SESSION_SECRET_KEY=generate-a-long-random-secret
SESSION_COOKIE_NAME=esdesk_session
# Keep false for the first LAN HTTP smoke.
# Switch to true when running behind HTTPS / reverse proxy.
SESSION_COOKIE_SECURE=false
DISABLE_ADMIN_IDLE_TIMEOUT=false
